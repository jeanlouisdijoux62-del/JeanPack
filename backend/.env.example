# Exemple de configuration SMTP pour backend
# Copiez en `.env` ou exportez ces variables avant de lancer app.py

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=utilisateur@example.com
SMTP_PASS=mot_de_passe
TO_EMAIL=destinataire@example.com

# Optionnel : activer/désactiver l'envoi réel
SEND_REAL_EMAILS=false
